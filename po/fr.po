msgstr "Le processus de récupération n'a pas répondu en %d s : il est arrêté."

#: src/worker_client.py:158
msgid "The scraper worker stopped responding (the browser may be stuck) and was terminated."
msgstr "Le processus de récupération ne répond plus (le navigateur est peut-être bloqué) et a été arrêté."

#: src/worker_client.py:163
msgid "The scraper worker process closed unexpectedly."
msgstr "Le processus de récupération s'est arrêté de façon inattendue."

#: src/worker_client.py:186
