msgstr "En attente de la vérification Cloudflare : cochez la case dans la fenêtre du navigateur"

#: src/worker_client.py:50
msgid "Logging in to Geneanet..."
msgstr "Connexion à Geneanet..."

#: src/worker_client.py:52
